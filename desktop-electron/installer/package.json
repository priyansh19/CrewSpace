{
  "name": "crewspace-installer",
  "version": "1.0.4",
  "description": "CrewSpace Windows installer wizard",
  "author": "CrewSpaceAI",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "electron-builder --win portable"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.crewspaceai.installer",
    "productName": "CrewSpace Setup",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "renderer-dist/**/*",
      "assets/**/*"
    ],
    "asar": false,
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "CrewSpace-Installer-${version}.exe"
    }
  }
}
